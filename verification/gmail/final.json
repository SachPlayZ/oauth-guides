    },
    {
      "id": "k4",
      "text": "Switching to your own auth config doesn't move existing connected accounts; users reconnect, or you import their credentials where supported.",
      "evidence": "documented",
      "sources": [
        {
          "url": "https://docs.composio.dev/docs/authentication/white-labeling-authentication",
          "quote": "Existing connected accounts are tied to the auth config they were created with.",
