      "checkedAt": "2026-11-09T17:54:28.830Z"
    },
    {
      "id": "g1",
      "text": "gmail.send is a sensitive scope; gmail.readonly, gmail.modify and gmail.compose are restricted.",
      "evidence": "documented",
      "sources": [
        {
          "url": "https://developers.google.com/workspace/gmail/api/auth/scopes",
          "quote": "Restricted scopes",
          "official": true,
          "retrievedAt": "2026-11-09T00:00:00.000Z"
