      "checkedAt": "2026-11-09T00:00:00.000Z"
    },
    {
      "id": "g2",
      "text": "Apps whose restricted-scope data passes through or is stored on a server must undergo an annual security assessment (CASA) by a Google-approved third party.",
      "evidence": "documented",
      "sources": [
        {
          "url": "https://developers.google.com/identity/protocols/oauth2/production-readiness/restricted-scope-verification",
          "quote": "must undergo an annual security assessment from an independent, third-party assessor that is approved by Google",
          "official": true,
          "retrievedAt": "2026-11-09T00:00:00.000Z"
        }
      ],
      "verifier": {
        "status": "supported",
        "note": "Hand-verified against the page, 2026-11-09"
      },
      "checkedAt": "2026-11-09T00:00:00.000Z"
    },
    {
      "id": "g3",
      "text": "Brand verification comes first and typically takes 2-3 business days when reviewed manually.",
      "evidence": "documented",
      "sources": [
        {
          "url": "https://developers.google.com/identity/protocols/oauth2/production-readiness/restricted-scope-verification",
          "quote": "must complete the brand verification step first, which typically takes 2-3 business days",
          "official": true,
          "retrievedAt": "2026-11-09T00:00:00.000Z"
        }
      ],
      "verifier": {
        "status": "supported",
        "note": "Hand-verified against the page, 2026-11-09"
      },
      "checkedAt": "2026-11-09T00:00:00.000Z"
    },
    {
      "id": "g4",
      "text": "Restricted scope verification can take several weeks.",
      "evidence": "documented",
      "sources": [
        {
          "url": "https://developers.google.com/identity/protocols/oauth2/production-readiness/restricted-scope-verification",
          "quote": "the restricted scopes verification process can potentially take several weeks to complete",
          "official": true,
          "retrievedAt": "2026-11-09T00:00:00.000Z"
        }
      ],
      "verifier": {
        "status": "supported",
        "note": "Hand-verified against the page, 2026-11-09"
