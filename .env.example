GEMINI_API_KEY=              # aistudio.google.com (free tier: content may be used to improve Google products)
TAVILY_API_KEY=              # tavily.com (free: 1,000 credits/month, no card)
COMPOSIO_API_KEY=            # server-side only; seeding + toolkit lookup
DATABASE_URL=                # local: postgres://runway:runway@localhost:54329/runway (docker compose up -d); prod: Neon
MODEL_RESEARCH=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash   # fallback chain
MODEL_SYNTH=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash
MODEL_VERIFY=gemini-3.5-flash-lite,gemini-3.1-flash-lite
MAX_GENERATIONS_PER_HOUR=30
DEMO_PASSCODE=               # required for generate/regenerate
