GROQ_API_KEY=                # console.groq.com (free: 8K tokens/min, 1,000 requests/day per model)
TAVILY_API_KEY=              # tavily.com (free: 1,000 credits/month, no card)
COMPOSIO_API_KEY=            # project key (ak_…) from Settings → Project Settings → API Keys; server-side only
DATABASE_URL=                # local: postgres://runway:runway@localhost:54329/runway (pnpm db:up); prod: Neon pooled URL (neon env pull)
DATABASE_URL_UNPOOLED=       # Neon direct URL, used by drizzle-kit for migrations; leave blank locally
# Optional model chains, "provider:model" comma-separated. Defaults live in lib/llm.ts.
MODEL_RESEARCH=
MODEL_SYNTH=
MODEL_VERIFY=
MAX_GENERATIONS_PER_HOUR=30
